#!/usr/bin/env bash
# Local convenience wrapper for `mix arca.config`, used when working ON
# arca_config. Loads this repository's own config/.env first if it exists; a
# fresh clone has no .env, and this used to fail outright in that case because
# `cat` on a missing file aborted the command before mix ever ran.
set -euo pipefail

if [ -f ./config/.env ]; then
  set -a
  # shellcheck disable=SC1091
  . ./config/.env
  set +a
fi

exec mix arca.config "$@"
