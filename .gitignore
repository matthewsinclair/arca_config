# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# ex_doc output. `bin/ac docs exdoc` writes it; it is generated from the source
# on demand and never committed. Left untracked-and-unignored it dirties the
# tree after every docs build, which trains everyone to ignore a dirty tree.
/doc/

# The directory Mix downloads your dependencies sources to.
/deps/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
icpzero-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Ignore WireGuard config 
peer-name.conf

# Ignore .elixir_ls
.elixir_ls

# Ignore .backup
.backup

# AGENTS.md regeneration safety net (intent agents sync writes this; transient).
/AGENTS.md.bak

# Never take .env into version control
.env
.env.*
config/.env

# This repository's own dev config location, written by ./scripts/cli and by
# anything run against config/.env. Four of these files were committed once,
# including a 2024 OAuth config; they are removed and this keeps them out.
/.arca_config/

# Per-developer Claude Code settings (paths and tool allowlists vary).
.claude/settings.local.json
